# ── Ollama (default backend — runs locally, no API key required) ──────────────
# Install Ollama: https://ollama.com/download
# Then pull a model:  ollama pull llama3
MELLEA_BACKEND=ollama
MELLEA_MODEL=llama3

# Optional: override Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI (optional — switch to this backend if preferred) ──────────────────
# MELLEA_BACKEND=openai
# MELLEA_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here
