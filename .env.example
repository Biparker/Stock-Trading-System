# ── MeLLeA Backend ────────────────────────────────────────────────────────────
# Choose ONE backend and set the corresponding API key.

# Option A: OpenAI (gpt-4o-mini is fast and cheap for structured outputs)
MELLEA_BACKEND=openai
MELLEA_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Option B: IBM Granite (recommended — matches MeLLeA's IBM Research origin)
# MELLEA_BACKEND=granite
# MELLEA_MODEL=ibm/granite-13b-instruct-v2
# IBM_API_KEY=your_ibm_api_key_here

# Option C: Ollama (fully local, no API key needed)
# MELLEA_BACKEND=ollama
# MELLEA_MODEL=llama3.1
# (no API key required)

# ── Merrill Lynch Credentials (for PDF report auto-download) ──────────────────
# Leave blank to use manually downloaded PDFs in sentiment_analyzer/Analyst_reports/
MERRILL_USERNAME=
MERRILL_PASSWORD=

# ── Pipeline Settings ─────────────────────────────────────────────────────────
PIPELINE_BUDGET=2500
